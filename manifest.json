{
  "manifest_version": 3,
  "name": "DELTA Research Collector",
  "short_name": "DELTA Collector",
  "version": "0.6.2",
  "description": "Coleta científica, verificação DOI transversal, triagem e auditoria bibliográfica.",
  "minimum_chrome_version": "109",
  "permissions": [
    "downloads",
    "storage",
    "unlimitedStorage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://arxiv.org/*",
    "https://www.ebi.ac.uk/europepmc/webservices/rest/*",
    "https://eutils.ncbi.nlm.nih.gov/entrez/eutils/*",
    "https://api.openalex.org/*",
    "https://api.datacite.org/dois/*",
    "https://api.crossref.org/works*",
    "https://api.semanticscholar.org/graph/v1/paper/search*",
    "https://doaj.org/api/search/articles/*",
    "https://search.scielo.org/*",
    "https://api.biorxiv.org/details/*",
    "https://ieeexplore.ieee.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Abrir DELTA Research Collector",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://arxiv.org/search/*",
        "https://europepmc.org/search*",
        "https://www.europepmc.org/search*",
        "https://pubmed.ncbi.nlm.nih.gov/*",
        "https://openalex.org/works*",
        "https://www.openalex.org/works*",
        "https://search.crossref.org/*",
        "https://crossref.org/search*",
        "https://www.crossref.org/search*",
        "https://semanticscholar.org/search*",
        "https://www.semanticscholar.org/search*",
        "https://search.scielo.org/*",
        "https://scielo.org/*/search/*",
        "https://www.scielo.org/*/search/*",
        "https://doaj.org/*",
        "https://www.doaj.org/*",
        "https://biorxiv.org/*",
        "https://www.biorxiv.org/*",
        "https://medrxiv.org/*",
        "https://www.medrxiv.org/*",
        "https://ieeexplore.ieee.org/search/*",
        "https://periodicos.capes.gov.br/*",
        "https://*.periodicos.capes.gov.br/*"
      ],
      "js": [
        "collector-core.js",
        "xref-engine.js",
        "review-matrix.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
